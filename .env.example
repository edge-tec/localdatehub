APP_NAME=LocalDateHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Primary Database (MySQL 8.0+ with GIS engine recommended for production)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=localdatehub
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# In production set SESSION_DRIVER=redis, SESSION_ENCRYPT=true, SESSION_SECURE_COOKIE=true
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=localdatehub_cache

ANALYTICS_ASYNC_ENABLED=true
ANALYTICS_QUEUE=analytics

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@localdatehub.com"
MAIL_FROM_NAME="${APP_NAME}"

# Storage / S3-compatible (MinIO / Cloudflare R2 / AWS S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=localdatehub-media
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=

# LocalDateHub Safety & System Controls
LOCALDATEHUB_AGE_MINIMUM=18
LOCALDATEHUB_DEFAULT_RADIUS_KM=25
LOCALDATEHUB_MAX_RADIUS_KM=150
LOCALDATEHUB_LOCATION_FUZZING_ENABLED=true
LOCALDATEHUB_PHOTO_EXIF_STRIP=true
LOCALDATEHUB_MODERATION_AUTO_FLAG=true
LOCALDATEHUB_HEALTH_CHECK_SECRET=change-this-health-check-secret-in-production

VITE_APP_NAME="${APP_NAME}"

# Social OAuth Authentication (Google & Facebook)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

# Cloudflare Turnstile Bot Protection
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
