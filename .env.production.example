# ==============================================================================
# LOCALADZONE — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env in production deployment. NEVER commit real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment & Security
# ------------------------------------------------------------------------------
APP_NAME=LocalAdZone
APP_ENV=production
APP_KEY=base64:GENERATE_VIA_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://localadzone.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=cache

# ------------------------------------------------------------------------------
# Logging & Error Tracking
# ------------------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_LEVEL=error
LOG_DEPRECATIONS_CHANNEL=null
LOG_DAILY_DAYS=30

# Optional Sentry / Bugsnag Error Monitoring
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# ------------------------------------------------------------------------------
# Production MySQL Database (MySQL 8)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=localadzone_prod
DB_USERNAME=localadzone_user
DB_PASSWORD=STRONG_PRODUCTION_DB_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ------------------------------------------------------------------------------
# Redis Cache, Session, & Queue Store
# ------------------------------------------------------------------------------
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.localadzone.com
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=STRONG_REDIS_AUTH_PASSWORD
REDIS_PORT=6379
REDIS_CACHE_DB=0
REDIS_SESSION_DB=1
REDIS_QUEUE_DB=2

# ------------------------------------------------------------------------------
# Media Storage (Private Cloud Object Storage / S3 / R2)
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=localadzone-media-production
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=https://media.localadzone.com

# ------------------------------------------------------------------------------
# Production Transactional Mail (Postmark / SES / Mailgun)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.postmarkapp.com
MAIL_PORT=587
MAIL_USERNAME=YOUR_POSTMARK_SERVER_TOKEN
MAIL_PASSWORD=YOUR_POSTMARK_SERVER_TOKEN
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@localadzone.com"
MAIL_FROM_NAME="LocalAdZone Notifications"

# ------------------------------------------------------------------------------
# Full-Text Search (Meilisearch Engine)
# ------------------------------------------------------------------------------
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=MEILISEARCH_MASTER_KEY_SECRET

# ------------------------------------------------------------------------------
# Adult Monetization & Payment Gateways (CCBill / Stripe Adult)
# ------------------------------------------------------------------------------
MONETIZATION_GATEWAY=ccbill
MONETIZATION_CURRENCY=USD

CCBILL_ACCOUNT_NUMBER=950000
CCBILL_SUBACCOUNT=0001
CCBILL_SALT=STRONG_CCBILL_MD5_SALT_KEY
CCBILL_FLEXFORM_ID=99999

STRIPE_ADULT_KEY=
STRIPE_ADULT_SECRET=
STRIPE_ADULT_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Age Assurance & Legal Compliance
# ------------------------------------------------------------------------------
AGE_ASSURANCE_PROVIDER=verisoul
AGE_ASSURANCE_API_KEY=
AGE_ASSURANCE_MIN_AGE=18

# ------------------------------------------------------------------------------
# Administrative MFA & Rate Limiting
# ------------------------------------------------------------------------------
ADMIN_MFA_REQUIRED=true
HEALTH_CHECK_SECRET=SECURE_RANDOM_HEALTH_TOKEN_64CHAR

